---
import tools from '../data/tools.json';

const categories = [...new Set(tools.map((t) => t.category))];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Local AI & Deskbot Companion Stack Directory</title>
    <meta name="description" content="The curated index of run-times, voice models, memory agents, and hardware for building local AI companions." />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen font-sans selection:bg-indigo-500 selection:text-white">
    <!-- Header -->
    <header class="border-b border-slate-800 bg-slate-900/60 backdrop-blur sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <span class="text-2xl">🤖</span>
          <span class="text-xl font-bold tracking-tight text-white">Deskbot<span class="text-indigo-400">Stack</span></span>
        </div>
        <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
          25 Curated Tools
        </span>
      </div>
    </header>

    <!-- Hero -->
    <section class="max-w-6xl mx-auto px-6 pt-12 pb-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight max-w-3xl mx-auto leading-tight">
        The Open Stack for <span class="text-indigo-400">Local AI & Physical Deskbots</span>
      </h1>
      <p class="mt-4 text-slate-400 max-w-2xl mx-auto text-base sm:text-lg">
        Compare offline LLM runtimes, low-latency voice engines, long-term memory agents, and controller hardware.
      </p>
    </section>

    <!-- Main Grid by Category -->
    <main class="max-w-6xl mx-auto px-6 space-y-12 pb-24">
      {categories.map((category) => (
        <section class="space-y-4">
          <h2 class="text-xl font-bold text-slate-200 border-l-4 border-indigo-500 pl-3">
            {category}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {tools.filter((t) => t.category === category).map((tool) => (
              <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 flex flex-col justify-between hover:border-slate-700 transition">
                <div>
                  <div class="flex justify-between items-start mb-2">
                    <h3 class="font-bold text-lg text-white">{tool.name}</h3>
                    <span class="text-[11px] font-medium px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700">
                      {tool.pricing.split('/')[0]}
                    </span>
                  </div>
                  <p class="text-xs font-medium text-indigo-400 mb-3">{tool.role}</p>
                  
                  <div class="space-y-2 text-xs text-slate-300">
                    <p><strong class="text-slate-400">Runs On:</strong> {tool.runsOn}</p>
                    <p><strong class="text-emerald-400">Pro:</strong> {tool.advantage}</p>
                    <p><strong class="text-rose-400">Limit:</strong> {tool.downside}</p>
                  </div>
                </div>

                <div class="mt-5 pt-4 border-t border-slate-800/80">
                  <a 
                    href={tool.targetLink} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="block text-center w-full py-2 px-3 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-xs font-semibold transition"
                  >
                    View Tool &rarr;
                  </a>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </main>
  </body>
</html>
